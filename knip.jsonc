{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The docs site, with its own lockfile.
  "ignore": ["doc/**"],
  // Generated by `pnpm --filter @edgeweir/console generate` (paraglide, TanStack Router); CI lints
  // before generating.
  "ignoreUnresolved": ["@/paraglide/.+", "@/routeTree.gen", "./routeTree.gen"],
  "ignoreBinaries": ["shellcheck"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "docker/e2e/*/server.mjs"],
      // protoc-gen-es is a buf plugin (proto/buf.gen.yaml).
      "ignoreDependencies": ["@bufbuild/protoc-gen-es"]
    },
    "apps/console": {
      "entry": [
        "src/server/{main,dev,recover}.ts",
        "src/web/routes/**/*.tsx",
        // The lab swaps @/lib/orpc and @/lib/auth-client for these (lab/vite.config.ts).
        "lab/*.{ts,tsx}",
        "scripts/*.{mjs,ts}"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "lab/**/*.{ts,tsx}", "test/**/*.ts", "e2e/**/*.ts"],
      // Loaded by project.inlang/settings.json.
      "ignoreDependencies": ["@inlang/plugin-.+"]
    },
    "packages/*": {
      // Internal packages: an export nothing in the repo imports is dead.
      "includeEntryExports": true
    },
    "packages/contract": {
      "entry": ["scripts/*.mjs"],
      "includeEntryExports": true
    },
    "packages/rule-engine": {
      "entry": ["scripts/*.mjs"],
      "includeEntryExports": true
    },
    // Generated code: its exports follow the .proto files.
    "packages/proto": {}
  }
}
