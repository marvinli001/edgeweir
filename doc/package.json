{
  "name": "@edgeweir/doc",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Edgeweir documentation site (Fumadocs, static export for GitHub Pages).",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "content": "node scripts/sync-content.mjs",
    "dev": "pnpm run content && next dev",
    "build": "pnpm run content && next build",
    "typecheck": "pnpm run content && next typegen && tsc --noEmit",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.15.15",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.15",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  }
}
