    },
    {
      "value": "http://99999999999/",
      "valid": false,
      "note": "number as host"
    },
    {
      "value": "http://1.2.3.4.5/",
      "valid": false,
      "note": "five numeric labels"
    },
    {
      "value": "http://256.1.1.1/",
      "valid": false,
