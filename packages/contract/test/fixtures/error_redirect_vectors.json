    },
    {
      "value": "javascript:alert(1)",
      "valid": false,
      "note": "script URL"
    },
    {
      "value": "https://example.com/{{host}}",
      "valid": false,
      "note": "unknown placeholder"
    },
    {
      "value": "https://example.com/a b",
      "valid": false,
      "note": "space"
    },
    {
      "value": "/a\\b",
      "valid": false,
      "note": "backslash"
    },
    {
      "value": "https://exa_mple.com/",
      "valid": false,
      "note": "underscore in the host"
    },
    {
      "value": "https://example.",
