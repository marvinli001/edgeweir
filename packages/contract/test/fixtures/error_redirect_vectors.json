    },
    {
      "value": "http://01.2.3.4/",
      "valid": false,
      "note": "IPv4 octet with a leading zero"
    },
    {
      "value": "http://a..b/",
      "valid": false,
      "note": "empty label"
    },
    {
      "value": "http://a.1b/",
      "valid": false,
      "note": "last label starting with a digit"
    },
    {
      "value": "http://example.com./",
      "valid": false,
      "note": "trailing dot"
    },
    {
      "value": "http://{{status}}.1.2.3/",
      "valid": false,
      "note": "placeholder in the host (sent as 502.1.2.3)"
    },
    {
      "value": "https://{{request_id}}.example.com/",
      "valid": false,
      "note": "placeholder in a host name"
    },
    {
      "value": "https://example.com:{{status}}/",
      "valid": false,
      "note": "placeholder in the port"
    },
    {
      "value": "http://[::{{status}}]/",
      "valid": false,
