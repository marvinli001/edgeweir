      "valid": false,
      "note": "unknown placeholder"
    },
    {
      "value": "https://example.com/a b",
      "valid": false,
      "note": "space"
    },
    {
      "value": "/a\\b",
      "valid": false,
      "note": "backslash"
    },
    {
