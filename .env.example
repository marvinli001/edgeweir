# Copy to .env and fill in.
# Master key for envelope-encrypting secrets at rest (CA keys, DNS API keys, ...):
# at least 32 bytes, base64. Generate with `openssl rand -base64 32` and use the
# output as is (do not strip "/", "+" or "="). Back it up: losing it makes stored
# secrets unrecoverable.
EDGEWEIR_MASTER_KEY=
# Session signing secret for better-auth (32+ characters): `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Password of the bundled PostgreSQL (only reachable inside the compose network).
# It is embedded in DATABASE_URL, so keep it URL-safe: `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Public URL of the console (what browsers use).
EDGEWEIR_PUBLIC_URL=http://localhost:3000
# URL nodes use to reach the node channel (TLS terminated by the console itself).
# Defaults to https://<host of EDGEWEIR_PUBLIC_URL>:8443
EDGEWEIR_NODE_API_URL=
# Extra names / IPs for the node channel certificate, comma separated.
EDGEWEIR_NODE_API_HOSTNAMES=
# Reverse proxies (IPs / CIDR ranges, comma separated) whose X-Forwarded-For and
# X-Real-IP are believed for audit IPs and sign-in rate limiting. Empty (default):
# the TCP peer is the client. Behind a proxy on the Docker host: its bridge
# gateway, e.g. 172.16.0.0/12.
EDGEWEIR_TRUSTED_PROXIES=
# Image tag to run.
EDGEWEIR_VERSION=latest

# Local development only (pnpm dev):
DATABASE_URL=postgres://edgeweir:edgeweir@localhost:5432/edgeweir
