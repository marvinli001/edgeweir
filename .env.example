# Copy to .env and fill in. compose.yml reads it; `pnpm dev` loads it into the
# console process. Every variable the console reads is listed here
# (apps/console/src/server/lib/env.ts); commented lines show the default.

# --- Required --------------------------------------------------------------
# Master key for envelope-encrypting secrets at rest (CA keys, DNS API keys, ...):
# at least 32 bytes, base64. Generate with `openssl rand -base64 32` and use the
# output as is (do not strip "/", "+" or "="). Back it up: losing it makes stored
# secrets unrecoverable.
EDGEWEIR_MASTER_KEY=
# Session signing secret for better-auth (32+ characters): `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Password of the bundled PostgreSQL (only reachable inside the compose network).
# It is embedded in DATABASE_URL, so keep it URL-safe: `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Public URL of the console (what browsers use).
EDGEWEIR_PUBLIC_URL=http://localhost:3000

# --- Node channel ----------------------------------------------------------
# URL nodes use to reach the node channel (TLS terminated by the console itself).
# Defaults to https://<host of EDGEWEIR_PUBLIC_URL>:<NODE_API_PORT>
EDGEWEIR_NODE_API_URL=
# Extra names / IPs for the node channel certificate, comma separated.
EDGEWEIR_NODE_API_HOSTNAMES=

# --- Network ---------------------------------------------------------------
# Reverse proxies (IPs / CIDR ranges, comma separated) whose X-Forwarded-For and
# X-Real-IP are believed for audit IPs and sign-in rate limiting. Empty (default):
# the TCP peer is the client. Behind a proxy on the Docker host: its bridge
# gateway, e.g. 172.16.0.0/12.
EDGEWEIR_TRUSTED_PROXIES=
# Host ports compose publishes (may include a bind address, e.g. 127.0.0.1:3000).
# EDGEWEIR_HTTP_PORT=3000
# EDGEWEIR_NODE_API_PORT=8443
# Listen address and ports of the console process itself (pnpm dev, bare runs;
# the image always listens on 3000 and 8443 and compose maps them).
# HOST=0.0.0.0
# PORT=3000
# NODE_API_PORT=8443

# --- Behaviour -------------------------------------------------------------
# Which parts run in this process: all (default), app (web/API/node channel) or
# worker (background jobs). compose.yml sets ROLE for its own service.
# ROLE=all
# Traffic statistics backend: lite (PostgreSQL, default) or clickhouse, which
# goes with the `analytics` compose profile and the connection below.
# EDGEWEIR_ANALYTICS=lite
# EDGEWEIR_CLICKHOUSE_URL=http://clickhouse:8123
# EDGEWEIR_CLICKHOUSE_DATABASE=edgeweir
# EDGEWEIR_CLICKHOUSE_USER=edgeweir
# EDGEWEIR_CLICKHOUSE_PASSWORD=
# Anonymous usage telemetry; off unless set to true (nothing is sent today).
# EDGEWEIR_TELEMETRY=false
# debug, info (default), warn or error.
# LOG_LEVEL=info
# NODE_ENV=production
# Directory with the built web UI (the image sets it; only for custom layouts).
# EDGEWEIR_WEB_DIST=
# Release mirror served at /downloads for install.sh (see docs/deploy/docker.md):
# edgeweir-node/latest, edgeweir-node/v<version>/<file>, cosign/v<version>/<file>.
# Unset (default): /downloads answers 404 and nodes download from GitHub.
# EDGEWEIR_DOWNLOADS_DIR=/srv/edgeweir-downloads

# --- Certificate helper ----------------------------------------------------
# Local development: (cd helpers/certd && go build -o bin/edgeweir-certd .)
# Set this to the resulting absolute path before starting pnpm dev.
EDGEWEIR_CERTD_BIN=edgeweir-certd
# Optional private/staging ACME directory and its trusted CA PEM file.
EDGEWEIR_ACME_DIRECTORY=
EDGEWEIR_ACME_CA_FILE=
# Optional recursive DNS servers for ownership TXT checks (comma-separated IP or hostname with optional port).
# Empty uses the operating system resolver. Set only by the operator.
EDGEWEIR_DNS_RESOLVERS=
# Local DNS simulator for integration testing only. Never set for real providers.
EDGEWEIR_DNS_TEST_ENDPOINT=
# Explicit private networks allowed for outbound requests: notification endpoints
# and a release source saved in 后台 → 系统设置 (default: public only).
EDGEWEIR_OUTBOUND_ALLOW_CIDRS=

# --- Image -----------------------------------------------------------------
# Image tag compose runs.
EDGEWEIR_VERSION=latest
# Password of the optional ClickHouse (`--profile analytics`).
# CLICKHOUSE_PASSWORD=edgeweir

# --- Local development only (pnpm dev) --------------------------------------
DATABASE_URL=postgres://edgeweir:edgeweir@localhost:5432/edgeweir

# --- Set in the console instead -------------------------------------------
# 后台 → 系统设置 edits these; a saved value there wins over the variable, which
# only remains as a fallback for existing deployments.
# Node release mirror (default: the official GitHub releases). Each node pins
# its own source and signature trust separately.
# EDGEWEIR_NODE_RELEASE_BASE_URL=
# CA bundle (file) for a private SMTP server; 系统设置 → SMTP → CA 证书 replaces it.
# EDGEWEIR_SMTP_CA_FILE=
