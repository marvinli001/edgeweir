# Copy to .env and fill in. compose.yml reads it; `pnpm dev` loads it into the
# console process. Every variable the console reads is listed here
# (apps/console/src/server/lib/env.ts). After setup, operator configuration
# lives in 后台 → 系统设置 (SMTP, node release source, DNS servers for ownership
# checks, origin allow list, GeoIP), not in this file.

# --- Required --------------------------------------------------------------
# Master key: envelope-encrypts secrets at rest (CA keys, DNS API keys, ...) and
# derives the session secret. At least 32 bytes, base64: generate it with
# `openssl rand -base64 32` and use the output as is (do not strip "/", "+" or
# "="). Back it up separately from the database: losing it makes stored secrets
# unrecoverable.
EDGEWEIR_MASTER_KEY=
# Password of the bundled PostgreSQL (only reachable inside the compose network).
# It is embedded in DATABASE_URL, so keep it URL-safe: `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# PostgreSQL connection for pnpm dev and plain `docker run`. compose builds its
# own from POSTGRES_PASSWORD and ignores this line.
DATABASE_URL=postgres://edgeweir:edgeweir@localhost:5432/edgeweir
# Public URL of the console (what browsers use).
EDGEWEIR_PUBLIC_URL=http://localhost:3000

# --- Optional (commented lines show the default) ---------------------------
# Each group says why it stays here rather than in 后台 → 系统设置.

# Session secret for better-auth (session cookies, two-factor secrets at rest);
# used before anyone signs in. Unset: derived from EDGEWEIR_MASTER_KEY with
# HKDF-SHA256 (SECURITY.md). Deployments that already set it must keep it (the
# console refuses to start once it is removed): a new secret signs everyone out
# and makes enrolled two-factor secrets unreadable.
# BETTER_AUTH_SECRET=
# Image tag compose pulls, so compose itself reads it. Rolling releases are
# tagged <YYYYMMDD>-<commit> (e.g. 20260929-a1b2c3d) and move `latest`; pin a
# dated tag in production. Inside the image it carries the running version.
# EDGEWEIR_VERSION=latest

# Node channel TLS identity: the server certificate is issued at startup for
# these names and enrolled nodes verify them. Default URL:
# https://<host of EDGEWEIR_PUBLIC_URL>:<NODE_API_PORT>
# EDGEWEIR_NODE_API_URL=
# Extra names / IPs for the node channel certificate, comma separated.
# EDGEWEIR_NODE_API_HOSTNAMES=

# Trust boundaries. Reverse proxies (IPs / CIDRs, comma separated) whose
# X-Forwarded-For / X-Real-IP are believed for audit IPs and sign-in rate
# limiting, from the first sign-in on. Empty: the TCP peer is the client. Behind
# a proxy on the Docker host: its bridge gateway, e.g. 172.16.0.0/12.
# EDGEWEIR_TRUSTED_PROXIES=
# Private networks the console may reach for destinations saved in the web
# console (webhooks, SMTP, release source, DNS servers); empty: public only. It
# bounds those web-saved values, so the web console cannot widen it.
# EDGEWEIR_OUTBOUND_ALLOW_CIDRS=

# Process and host, read before the database is reachable. Ports compose
# publishes (may include a bind address, e.g. 127.0.0.1:3000):
# EDGEWEIR_HTTP_PORT=3000
# EDGEWEIR_NODE_API_PORT=8443
# Listen address and ports of the process (pnpm dev, bare runs; the image always
# listens on 3000 and 8443). ROLE: all, app (web/API/node channel) or worker.
# HOST=0.0.0.0
# PORT=3000
# NODE_API_PORT=8443
# ROLE=all
# LOG_LEVEL=info
# NODE_ENV=production
# Paths: built web UI and certificate helper (the image sets both; for pnpm dev
# build the helper with `cd helpers/certd && go build -o bin/edgeweir-certd .`
# and give its absolute path), and the release mirror served at /downloads for
# install.sh (docs/deploy/docker.md; unset: 404, nodes use GitHub).
# EDGEWEIR_WEB_DIST=
# EDGEWEIR_CERTD_BIN=edgeweir-certd
# EDGEWEIR_DOWNLOADS_DIR=/srv/edgeweir-downloads

# Infrastructure wiring. Traffic statistics: lite (PostgreSQL) or clickhouse,
# deployed with the `analytics` compose profile, whose container reads the same
# password; switching does not migrate history.
# EDGEWEIR_ANALYTICS=lite
# EDGEWEIR_CLICKHOUSE_URL=http://clickhouse:8123
# EDGEWEIR_CLICKHOUSE_DATABASE=edgeweir
# EDGEWEIR_CLICKHOUSE_USER=edgeweir
# EDGEWEIR_CLICKHOUSE_PASSWORD=
# CLICKHOUSE_PASSWORD=edgeweir
# Private or staging ACME directory for every certificate, and the CA file its
# TLS is verified with. Private PKI and tests only: accounts do not move between
# directories and the certificate helper contacts it directly. The usual CA is
# chosen per certificate in the console.
# EDGEWEIR_ACME_DIRECTORY=
# EDGEWEIR_ACME_CA_FILE=

# Anonymous usage telemetry: off unless true. Nothing is sent today, so the
# console has no switch for it.
# EDGEWEIR_TELEMETRY=false
# Local DNS simulator for integration tests only. Never set for real providers.
# EDGEWEIR_DNS_TEST_ENDPOINT=

# --- Set in the console instead --------------------------------------------
# 后台 → 系统设置 edits these; a saved value there wins over the variable, which
# only remains as a fallback for existing deployments.
# Node release mirror (default: the official GitHub releases). Each node pins
# its own source and signature trust separately.
# EDGEWEIR_NODE_RELEASE_BASE_URL=
# CA bundle (file) for a private SMTP server; 系统设置 → SMTP → CA 证书 replaces it.
# EDGEWEIR_SMTP_CA_FILE=
# Recursive DNS servers for ownership TXT checks (comma-separated IP or host
# name with optional port; default: the system resolver); 系统设置 → 所有权校验
# DNS replaces them.
# EDGEWEIR_DNS_RESOLVERS=
