{
  "name": "edgeweir",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @edgeweir/console dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check . && buf lint proto",
    "format": "biome check --write .",
    "proto:lint": "buf lint proto",
    "proto:gen": "buf generate proto --template proto/buf.gen.yaml",
    "db:generate": "pnpm --filter @edgeweir/db generate",
    "e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "turbo": "2.11.4",
    "typescript": "7.0.2"
  }
}
