{
  "name": "@edgeweir/console",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Edgeweir console: web UI, API and node channel in one Node.js process.",
  "type": "module",
  "imports": {
    "#server/*": "./src/server/*"
  },
  "scripts": {
    "generate": "paraglide-js compile --project ./project.inlang --outdir ./src/web/paraglide --strategy localStorage preferredLanguage baseLocale && tsr generate",
    "dev": "tsx watch --env-file-if-exists=../../.env --clear-screen=false --exclude './src/web/**' src/server/dev.ts",
    "lab": "vite --config lab/vite.config.ts",
    "lab:build": "vite build --config lab/vite.config.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/main.js",
    "recover": "tsx --env-file-if-exists=../../.env src/server/recover.ts",
    "typecheck": "pnpm run generate && tsc -p tsconfig.web.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json && tsc -p tsconfig.lab.json",
    "test": "pnpm run generate && vitest run",
    "test:e2e": "playwright test",
    "ui:preset": "shadcn preset resolve --json"
  },
  "dependencies": {
    "@appica/ui-react": "1.2.0",
    "@base-ui/react": "1.8.0",
    "@better-auth/api-key": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@dagrejs/dagre": "3.1.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@edgeweir/config-compiler": "workspace:*",
    "@edgeweir/contract": "workspace:*",
    "@edgeweir/db": "workspace:*",
    "@edgeweir/proto": "workspace:*",
    "@edgeweir/rule-engine": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@hono/node-server": "2.1.1",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@number-flow/react": "0.6.2",
    "@orpc/client": "1.15.4",
    "@orpc/contract": "1.15.4",
    "@orpc/openapi": "1.15.4",
    "@orpc/server": "1.15.4",
    "@orpc/tanstack-query": "1.15.4",
    "@orpc/zod": "1.15.4",
    "@paper-design/shaders-react": "0.0.81",
    "@peculiar/x509": "2.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@xyflow/react": "12.12.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "cobe": "2.0.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "motion": "13.5.1",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "reflect-metadata": "0.2.2",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uplot": "1.6.32",
    "uqr": "0.1.3",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
